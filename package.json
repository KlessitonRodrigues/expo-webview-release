{
  "name": "@apps/expo-profile-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "start-container": "docker compose up -d --build",
    "stop-container": "docker compose down",
    "build:apk": "docker compose run --rm eas-builder eas build -p android --profile preview --local --non-interactive --output out/personal-cv.apk"
  },
  "dependencies": {
    "expo": "^57.0.2",
    "expo-status-bar": "^57.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-native": "0.86.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@types/react": "~19.2.4",
    "expo-dev-client": "~57.0.5",
    "typescript": "^5.9.3"
  }
}
